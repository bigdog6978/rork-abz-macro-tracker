# Copy to .env for local development. All keys are optional — features
# no-op safely when a key is absent.

# Apple Developer Team ID (10 chars) — required for prebuild signing of the
# watch + widget targets (see docs/WATCH.md).
APPLE_TEAM_ID=

# USDA FoodData Central — food search (docs/DECISIONS.md).
EXPO_PUBLIC_USDA_API_KEY=

# RevenueCat (iOS) — only used once IAP_MONETIZATION_ENABLED is true
# (services/iapMapping.ts; see APP_STORE_SUBMISSION.md launch checklist).
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=

# Crash reporting — create a React Native project at sentry.io.
# Disabled in dev builds; source-map upload is a separate launch step
# (npx @sentry/wizard -i reactNative).
EXPO_PUBLIC_SENTRY_DSN=

# Product analytics — create a project at posthog.com (autocapture is off;
# only the explicit events in services/analytics.ts are sent, no PII).
EXPO_PUBLIC_POSTHOG_API_KEY=
# EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Dev/internal-review only — never set in App Store production builds.
EXPO_PUBLIC_DEV_UNLOCK_PREMIUM=
